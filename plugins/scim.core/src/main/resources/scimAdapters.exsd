<?xml version='1.0' encoding='UTF-8'?>
<!-- Schema file for the org.apache.directory.studio.scimAdapters extension point -->
<schema targetNamespace="org.apache.directory.studio.scim.core" xmlns="http://www.eclipse.org/PDEX/v2_0">
<annotation>
      <appinfo>
         <meta.schema plugin="org.apache.directory.studio.scim.core"
                      id="org.apache.directory.studio.scimAdapters"
                      name="SCIM Adapter Factories"/>
      </appinfo>
      <documentation>
         Registers IScimAdapterFactory implementations so scim.core can discover
         and instantiate adapters for specific SCIM providers at runtime.
      </documentation>
   </annotation>

   <element name="extension">
      <annotation>
         <appinfo>
            <meta.element />
         </appinfo>
      </annotation>
      <complexType>
         <sequence>
            <element ref="scimAdapter" minOccurs="1" maxOccurs="unbounded"/>
         </sequence>
         <attribute name="point" type="string" use="required"/>
         <attribute name="id" type="string"/>
         <attribute name="name" type="string"/>
      </complexType>
   </element>

   <element name="scimAdapter">
      <complexType>
         <attribute name="class" type="string" use="required">
            <annotation>
               <documentation>
                  Fully-qualified class name implementing
                  org.apache.directory.studio.scim.core.adapter.IScimAdapterFactory.
               </documentation>
               <appinfo>
                  <meta.attribute kind="java"
                     interface="org.apache.directory.studio.scim.core.adapter.IScimAdapterFactory"/>
               </appinfo>
            </annotation>
         </attribute>
         <attribute name="id" type="string" use="required">
            <annotation>
               <documentation>
                  Unique identifier for this adapter factory (e.g. "com.example.MyScimAdapter").
               </documentation>
            </annotation>
         </attribute>
         <attribute name="name" type="string" use="required">
            <annotation>
               <documentation>
                  Human-readable display name for this adapter factory.
               </documentation>
            </annotation>
         </attribute>
      </complexType>
   </element>

   <annotation>
      <appinfo>
         <meta.section type="since"/>
      </appinfo>
      <documentation>
         2026.8.14
      </documentation>
   </annotation>

</schema>
